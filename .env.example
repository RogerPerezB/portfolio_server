# ==========================================
# PORTFOLIO TELEMETRY SERVER ENVIRONMENT CONFIG
# ==========================================

# Server Host & Port
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Local JSON Database File Path
DB_FILE_PATH=data/telemetry_db.json

# Garmin / Intervals.icu API Settings
# Get your API key from Intervals.icu -> Settings -> API Access
INTERVALS_API_KEY=your_intervals_api_key_here
INTERVALS_ATHLETE_ID=0

# Polling Configuration (Eastern Time / Gatineau QC)
# Polls every 30 minutes starting at 8:00 AM until today's score is received
TIMEZONE=America/Toronto
POLL_START_HOUR=8
GARMIN_POLL_INTERVAL_MINUTES=30

# LeetCode Configuration
LEETCODE_USERNAME=rogerpb
LEETCODE_POLL_INTERVAL_HOURS=2
