# ==========================================
# PORTFOLIO TELEMETRY SERVER ENVIRONMENT CONFIG
# ==========================================

# Server Host & Port
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Garmin / Intervals.icu API Settings
# Get your API key from Intervals.icu -> Settings -> API Access
INTERVALS_API_KEY=your_intervals_api_key_here
INTERVALS_ATHLETE_ID=0

# Polling Window Configuration (Eastern Time / Gatineau QC)
TIMEZONE=America/Toronto
POLL_START_HOUR=8
POLL_END_HOUR=13
DEFAULT_SLEEP_SCORE=85

# LeetCode Configuration
LEETCODE_USERNAME=RogerPerezB
LEETCODE_POLL_INTERVAL_HOURS=2
